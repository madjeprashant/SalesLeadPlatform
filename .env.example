# Copy to .env and replace every value with private values before deploying.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
SECRET_KEY=replace-with-a-long-random-secret-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-admin-password-12-chars-minimum
SALES_PASSWORD=replace-with-a-unique-sales-password-12-chars-minimum
API_TOKEN_TTL=3600
APP_PORT=8000
# Set true when the site is served over HTTPS. Keep false only for local HTTP testing.
SESSION_COOKIE_SECURE=true
